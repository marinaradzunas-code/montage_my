# Зависимости и сборка
node_modules/
out/
build/
.cache/
.venv/
__pycache__/
*.log

# Секреты
.env
.env.*

# Модель распознавания речи — качается автоматически при первом импорте
.models/

# Свои исходники и личный материал: в репозиторий не попадают
public/projects/
public/clip.mp4
*.mp4
*.mov
*.wav
# Короткие акценты монтажа синтезированы для проекта и входят в шаблон.
!public/soft-tick.wav
!public/soft-move.wav
*.mp3
*.m4a

# Композиции, которые генерирует scripts/import-video.py
# Личный набор эмодзи: чужие шрифты не распространяем вместе с шаблоном
public/emoji-local/
# Авторские шрифты с чужой лицензией (Coolvetica и т.п.): только на своём диске.
# В шаблон уходит только инструкция, куда положить свой файл.
public/fonts-local/*
!public/fonts-local/README.md

src/generated/

# Личные композиции и эксперименты — только на твоём диске
src/local/

# Снимки утверждённых монтажей (пресеты): личные, с исходниками
presets/

# Кадры и звук чужих роликов: разбираем локально, в шаблон уходит только конспект
references/*/

# Локальные патчи и авторизация не являются частью шаблона
*.patch
.gh-auth/
gh-auth/
hosts.yml
